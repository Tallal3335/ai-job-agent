# Environment Variables Configuration
# Copy this file to .env and fill in with your actual credentials

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/job_agent
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=job_agent

# ============================================
# JOB BOARD CREDENTIALS - BAYT.COM
# ============================================
BAYT_EMAIL=your-email@bayt.com
BAYT_PASSWORD=your-password
BAYT_ENABLED=true

# ============================================
# JOB BOARD CREDENTIALS - NAUKRI.COM
# ============================================
NAUKRI_EMAIL=your-email@naukri.com
NAUKRI_PASSWORD=your-password
NAUKRI_ENABLED=true

# ============================================
# JOB BOARD CREDENTIALS - GULFTALENT.COM
# ============================================
GULFTALENT_EMAIL=your-email@gulftalent.com
GULFTALENT_PASSWORD=your-password
GULFTALENT_ENABLED=true

# ============================================
# JOB BOARD CREDENTIALS - UPWORK.COM
# ============================================
UPWORK_API_KEY=your-api-key
UPWORK_API_SECRET=your-api-secret
UPWORK_ENABLED=true

# ============================================
# JOB BOARD CREDENTIALS - LINKEDIN.COM
# ============================================
LINKEDIN_EMAIL=your-email@linkedin.com
LINKEDIN_PASSWORD=your-password
LINKEDIN_ENABLED=true

# ============================================
# JOB SEARCH FILTERS
# ============================================
# Comma-separated keywords to search for
KEYWORDS=Software Engineer,Backend Developer,Full Stack,Node.js

# Comma-separated locations to search in
LOCATIONS=Dubai,Bangalore,Riyadh,Singapore

# Salary range (in USD or local currency)
MIN_SALARY=50000
MAX_SALARY=200000

# Excluded keywords (jobs with these will be filtered out)
EXCLUDED_KEYWORDS=Intern,Trainee,Contract

# ============================================
# AUTO-APPLY SETTINGS
# ============================================
# Enable automatic applications to matching jobs
AUTO_APPLY=true

# ============================================
# EMAIL NOTIFICATIONS
# ============================================
EMAIL_NOTIFICATIONS=true
NOTIFICATION_EMAIL=your-personal-email@gmail.com

# SMTP Server Configuration (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Note: For Gmail, generate an App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Windows Computer" (or your device)
# 3. Copy the 16-character password and paste it above

# ============================================
# CV CONFIGURATION
# ============================================
CV_FILE_PATH=./cv.pdf

# ============================================
# SCHEDULING
# ============================================
# How often to run job searches (in hours)
SEARCH_INTERVAL_HOURS=6

# Interval between applications (in minutes)
APPLY_INTERVAL_MINUTES=30

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# PUPPETEER (BROWSER AUTOMATION)
# ============================================
# Run browser in headless mode (no GUI)
PUPPETEER_HEADLESS=true

# Timeout for browser operations (in milliseconds)
PUPPETEER_TIMEOUT=30000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# CACHE SETTINGS
# ============================================
# Prevent applying to the same job twice (in days)
CACHE_DUPLICATE_DAYS=30
